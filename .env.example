GEMINI_API_KEY=your_gemini_api_key_here
REMOVE_BG_API_KEY=your_remove_bg_api_key_here
OWNER_NUMBER=628xxxxxxxxxx
BOT_NAME=MyBot
SESSION_SECRET=your_session_secret_here
TIMEZONE=Asia/Jakarta

# === GOOGLE DRIVE (upload media + backup database) ===
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_TYPE=service_account
# Service Account: isi salah satu (file JSON key) ATAU (client_email + private_key)
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# OAuth2 (jika GOOGLE_DRIVE_TYPE=oauth2)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost
# Folder target untuk media
GOOGLE_DRIVE_FOLDER_ID=
# Backup database otomatis (24 jam)
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_BACKUP_CRON=0 0 * * *
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_ON_START=false
