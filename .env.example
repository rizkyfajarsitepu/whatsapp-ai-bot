GEMINI_API_KEY=your_gemini_api_key_here
REMOVE_BG_API_KEY=your_remove_bg_api_key_here
OWNER_NUMBER=628xxxxxxxxxx
BOT_NAME=MyBot
SESSION_SECRET=your_session_secret_here
TIMEZONE=Asia/Jakarta

# === GOOGLE DRIVE (upload media + backup database) ===
# Wajib pakai OAuth2 (Service Account tidak punya storage quota utk Drive pribadi)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_TYPE=oauth2
# OAuth2: buat di Google Cloud Console (OAuth client ID, tipe Desktop app),
# lalu generate refresh token lewat: node scripts/generateDriveToken.js
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost
# Folder target untuk media
GOOGLE_DRIVE_FOLDER_ID=
# Folder terpisah per tipe media (opsional, kosongkan untuk pakai GOOGLE_DRIVE_FOLDER_ID)
GDRIVE_FOLDER_PHOTOS=
GDRIVE_FOLDER_VIDEOS=
GDRIVE_FOLDER_AUDIO=
GDRIVE_FOLDER_DOCS=
# Backup database otomatis (24 jam)
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_BACKUP_CRON=0 0 * * *
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_ON_START=false
